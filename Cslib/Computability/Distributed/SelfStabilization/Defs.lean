module

public import Cslib.Init
public import Mathlib.Data.Set.Basic

/-!
# Self- and pseudo-stabilization for a class of executions

The execution-based definitions of stabilization (Dijkstra; Burns, Gouda and Miller), for an
arbitrary class `Exec : Set (ℕ → X)` of executions (sequences of configurations) and a
specification `SP : (ℕ → X) → Prop` (a predicate on executions). The class encodes the model:
algorithm, daemon / scheduler, dynamic graph, initial configurations, faults. See
`SelfStabilization/Daemon.lean` for the classes generated by activation daemons and
`SelfStabilization/TransitionSystem.lean` for the relational (reachability-based) notions of a
transition system.

## Main definitions

* `SuffixClosed Exec`: every suffix of an execution is an execution ("recurring" classes).
* `IsLegitimate Exec SP L`: every execution reaches `L` (convergence) and every execution starting
  in `L` satisfies `SP` (correctness / closure).
* `SelfStabilizing Exec SP`: some set of configurations is legitimate.
* `PseudoStabilizing Exec SP`: every execution has a suffix satisfying `SP`.
* `PseudoStabilizingWithin Exec SP T`: the suffix of every execution from time `T` satisfies `SP`
  (stabilization time at most `T`).

## Main results

* `SelfStabilizing.pseudoStabilizing`: on a suffix-closed class, self-stabilization implies
  pseudo-stabilization.
* `selfStabilizing_iff_exists_nonempty`: the legitimate set may be required to be nonempty (as in
  some papers' definitions) without changing the notion, as long as configurations exist.

## References

* [J. E. Burns, M. G. Gouda, R. E. Miller, *Stabilization and pseudo-stabilization*][BurnsGM1993]
-/

@[expose] public section

namespace Cslib.SelfStabilization

variable {X : Type*} (Exec : Set (ℕ → X)) (SP : (ℕ → X) → Prop)

/-- The class of executions is *suffix-closed*: every suffix of an execution is an execution. -/
def SuffixClosed : Prop := ∀ e ∈ Exec, ∀ i, (fun t => e (i + t)) ∈ Exec

/-- `L` is a set of *legitimate* configurations for the specification `SP` on the class `Exec`:
every execution reaches `L` (convergence) and every execution starting in `L` satisfies `SP`
(correctness). -/
def IsLegitimate (L : Set X) : Prop := (∀ e ∈ Exec, ∃ t, e t ∈ L) ∧ ∀ e ∈ Exec, e 0 ∈ L → SP e

/-- *Self-stabilization* for the specification `SP` on the class `Exec`: some set of
configurations is legitimate. -/
def SelfStabilizing : Prop := ∃ L, IsLegitimate Exec SP L

/-- *Pseudo-stabilization* for `SP` on `Exec`: every execution has a suffix satisfying `SP`. -/
def PseudoStabilizing : Prop := ∀ e ∈ Exec, ∃ i, SP (fun t => e (i + t))

/-- Pseudo-stabilization *within `T` steps*: the suffix of every execution from time `T` on
satisfies `SP`. -/
def PseudoStabilizingWithin (T : ℕ) : Prop := ∀ e ∈ Exec, SP (fun t => e (T + t))

variable {Exec SP} {Exec' : Set (ℕ → X)} {L : Set X}

/-- A legitimate set stays legitimate for a subclass of executions. -/
theorem IsLegitimate.mono (h : IsLegitimate Exec SP L) (hE : Exec' ⊆ Exec) :
    IsLegitimate Exec' SP L :=
  ⟨fun e he => h.1 e (hE he), fun e he => h.2 e (hE he)⟩

/-- A legitimate set is nonempty as soon as some execution exists. -/
theorem IsLegitimate.nonempty (h : IsLegitimate Exec SP L) (hE : Exec.Nonempty) : L.Nonempty :=
  let ⟨e, he⟩ := hE
  let ⟨t, ht⟩ := h.1 e he
  ⟨e t, ht⟩

/-- Self-stabilization is inherited by subclasses of executions. -/
theorem SelfStabilizing.mono (h : SelfStabilizing Exec SP) (hE : Exec' ⊆ Exec) :
    SelfStabilizing Exec' SP :=
  let ⟨L, hL⟩ := h
  ⟨L, hL.mono hE⟩

/-- Pseudo-stabilization is inherited by subclasses of executions. -/
theorem PseudoStabilizing.mono (h : PseudoStabilizing Exec SP) (hE : Exec' ⊆ Exec) :
    PseudoStabilizing Exec' SP :=
  fun e he => h e (hE he)

/-- Pseudo-stabilization within `T` steps is inherited by subclasses of executions. -/
theorem PseudoStabilizingWithin.mono {T : ℕ} (h : PseudoStabilizingWithin Exec SP T)
    (hE : Exec' ⊆ Exec) : PseudoStabilizingWithin Exec' SP T :=
  fun e he => h e (hE he)

/-- Pseudo-stabilization within `T` steps is pseudo-stabilization. -/
theorem PseudoStabilizingWithin.pseudoStabilizing {T : ℕ}
    (h : PseudoStabilizingWithin Exec SP T) : PseudoStabilizing Exec SP :=
  fun e he => ⟨T, h e he⟩

/-- On a suffix-closed class, self-stabilization implies pseudo-stabilization: the suffix from the
time the execution enters the legitimate set satisfies the specification. -/
theorem SelfStabilizing.pseudoStabilizing (hE : SuffixClosed Exec)
    (h : SelfStabilizing Exec SP) : PseudoStabilizing Exec SP := by
  obtain ⟨L, hconv, hcorr⟩ := h
  intro e he
  obtain ⟨i, hi⟩ := hconv e he
  exact ⟨i, hcorr _ (hE e he i) (by simpa using hi)⟩

/-- Requiring the legitimate set to be nonempty does not change self-stabilization (when there is
a configuration): if there is no execution, every set, e.g. `Set.univ`, is legitimate. -/
theorem selfStabilizing_iff_exists_nonempty [Nonempty X] :
    SelfStabilizing Exec SP ↔ ∃ L : Set X, L.Nonempty ∧ IsLegitimate Exec SP L := by
  refine ⟨fun ⟨L, hL⟩ => ?_, fun ⟨L, _, hL⟩ => ⟨L, hL⟩⟩
  rcases Exec.eq_empty_or_nonempty with hE | hE
  · exact ⟨Set.univ, Set.univ_nonempty, by simp [IsLegitimate, hE]⟩
  · exact ⟨L, hL.nonempty hE, hL⟩

end Cslib.SelfStabilization
